# Keep the build context small and, more importantly, keep secrets out of the
# image: a copy of .env would bake the bot token into a layer.
.env
.env.*

.git
.gitignore
.github

# The economy lives on a mounted volume, never in the image.
data/

# Build output and dependencies are produced inside the image; copying them from
# the host would shadow the linux-native @napi-rs/canvas binary with a host one.
node_modules/
dist/

# Not needed at runtime.
tests/
*.md
*.png
.DS_Store
