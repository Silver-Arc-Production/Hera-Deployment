# Keep build context small and, more importantly, keep secrets out of the
# image: a copy of .env would bake the bot token into a layer.
.env
.env.*

.git
.gitignore
.github

# The economy lives on a mounted volume, never in the image.
data/

__pycache__/
**/__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# Not needed at runtime.
tests/
*.md
*.png
.DS_Store
