# Copy to .env and fill in. Never commit the real .env file.
DISCORD_TOKEN=

# Optional: register slash commands instantly in one guild instead of globally.
DISCORD_GUILD_ID=

# Optional: channel for market news and tick announcements.
STOCK_NEWS_CHANNEL_ID=

# Optional: the prefix for message commands. Every command also exists as a slash
# command, so these are two spellings of the same thing. Requires the Message
# Content intent to be enabled for the bot.
COMMAND_PREFIX=!

# Optional tuning
DATABASE_PATH=data/hera.db
CURRENCY_SYMBOL=🪙
CURRENCY_NAME=credits
STOCK_TICK_SECONDS=300
