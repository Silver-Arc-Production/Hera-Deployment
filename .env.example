# Copy to .env and fill in. Never commit the real .env file.

# ------------------------------------------------------------------ the bot
DISCORD_TOKEN=

# Optional: register slash commands instantly in one guild instead of globally.
DISCORD_GUILD_ID=

# Optional: the prefix for message commands. Every command also exists as a slash
# command, so these are two spellings of the same thing. Requires the Message
# Content intent to be enabled for the bot.
COMMAND_PREFIX=!

# Optional: channel for market news and tick announcements.
STOCK_NEWS_CHANNEL_ID=

# Optional: Discord user id allowed to run operator commands (defaults to the
# guild owner).
HERA_OWNER_ID=

# Optional tuning
DATABASE_PATH=data/hera.db
CURRENCY_SYMBOL=🪙
CURRENCY_NAME=credits
STOCK_TICK_SECONDS=300

# ------------------------------------------------------- the web dashboard
# Set WEB_ENABLED=true to serve the read-only dashboard. With the bot process
# (npm start) it shares the bot's live database and market; the standalone
# entrypoint (npm run web) opens its own connection to DATABASE_PATH.
WEB_ENABLED=false
WEB_BIND_HOST=0.0.0.0
WEB_PORT=8080
