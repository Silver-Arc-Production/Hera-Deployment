{
  "name": "hera",
  "version": "1.0.0",
  "private": true,
  "description": "A multipurpose economy Discord bot: simulated stock exchange, trading and a wallet/bank economy.",
  "license": "MIT",
  "type": "commonjs",
  "main": "dist/hera/index.js",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "start": "node --disable-warning=ExperimentalWarning dist/hera/index.js",
    "web": "node --disable-warning=ExperimentalWarning dist/dashboard/index.js",
    "dev": "tsx watch hera/index.ts",
    "web:dev": "tsx watch dashboard/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test \"tests/test_*.ts\""
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.65",
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
